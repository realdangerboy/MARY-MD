{
  "name": "mary-md",
  "version": "1.0.0",
  "description": "MARY MD - Bilingual WhatsApp Bot (EN/ES)",
  "type": "module",
  "main": "mary.js",
  "scripts": {
    "start": "node mary.js",
    "dev": "node --watch mary.js",
    "pm2": "pm2 start mary.js --name mary-md --no-daemon",
    "pm2:stop": "pm2 stop mary-md",
    "pm2:restart": "pm2 restart mary-md",
    "pm2:logs": "pm2 logs mary-md"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "github:itsliaaa/baileys",
    "awesome-phonenumber": "^6.10.0",
    "axios": "^1.6.8",
    "chalk": "^5.3.0",
    "dotenv": "^16.0.0",
    "file-type": "^19.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.0",
    "jimp": "^1.6.1",
    "mime-types": "^2.1.35",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "node-webpmux": "^3.2.0",
    "pino": "^8.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "pm2": "^5.4.2"
  }
}
